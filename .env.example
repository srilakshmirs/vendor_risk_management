# ───────────────────────────────────────────────────────────────────
# VRM Intelligence — environment template
# Copy this file to `.env` and fill in the blanks.
# ───────────────────────────────────────────────────────────────────

# --- App ---
ENVIRONMENT=dev                  # dev | staging | prod
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3001","http://localhost:3000"]

# --- Database ---
# Postgres + pgvector (default). Bring it up with: `docker compose up -d postgres`
DATABASE_URL=postgresql+psycopg://vrm:vrm@localhost:5432/vrm
# Or fall back to SQLite (no Docker required):
# DATABASE_URL=sqlite:///./vrm.db

# ───────────────────────────────────────────────────────────────────
# LLM provider toggle — pick ONE
#   ollama  → uses your local Ollama daemon (llama3.2 by default)
#   claude  → uses Anthropic API; requires ANTHROPIC_API_KEY
#   mock    → canned responses, no network calls (for CI / demos)
# ───────────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama

# --- Anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_SMART=claude-sonnet-4-6

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Scoring weights (must sum to 1.0) ---
WEIGHT_BREACH=0.30
WEIGHT_DATA_ACCESS=0.25
WEIGHT_COMPLIANCE=0.20
WEIGHT_FINANCIAL=0.15
WEIGHT_OPERATIONAL=0.10
